rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'organization', 'role', 'bio', 'phoneNumber', 'emailVerified', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() > 3 && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('organization' in data) || (data.organization is string && data.organization.size() <= 120))
        && (!('role' in data) || (data.role in ['manager', 'farmer', 'agronomist', 'technician', 'viewer']))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30))
        && (!('emailVerified' in data) || data.emailVerified is bool);
    }

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming())
                    && incoming().uid == existing().uid;
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
